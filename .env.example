# FaceTrack AI - Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://facetrack:facetrack_pass@localhost:5432/facetrack_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facetrack_db
DB_USER=facetrack
DB_PASSWORD=facetrack_pass

# ============================================
# Backend Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_PORT=8000

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=FaceTrack AI
FRONTEND_PORT=8080

# ============================================
# Face Recognition Configuration
# ============================================
FACE_RECOGNITION_MODEL=HOG
# Options: HOG (faster, CPU) or CNN (more accurate, GPU)
FACE_EMBEDDING_DIMENSIONS=128
FACE_MATCH_THRESHOLD=0.6
# Threshold for cosine similarity (0.6 = 60% similarity)
MAX_FACE_SAMPLES=10
MIN_FACE_SAMPLES=3

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@facetrack.ai

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
# 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT=5

# ============================================
# Security
# ============================================
HTTPS_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
